// storage.rules — Firebase Storage for Vaulte (Fix 122): the profile photo, and nothing else.
// Each person reads and writes only their own photo (profile-photos/{uid}.jpg): an image under 5 MB.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile-photos/{file} {
      allow read: if request.auth != null && file == request.auth.uid + ".jpg";
      allow write: if request.auth != null && file == request.auth.uid + ".jpg"
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && file == request.auth.uid + ".jpg";
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
