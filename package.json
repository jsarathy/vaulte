{
  "name": "vaulte",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "audit:ci": "node scripts/audit-check.mjs",
    "secrets": "gitleaks git --redact --no-banner --log-opts=\"--all -- . :!node_modules :!dist :!package-lock.json\" .",
    "lint": "eslint .",
    "quality": "node scripts/quality-report.mjs",
    "test:ui": "playwright test",
    "test:api": "npx --yes firebase-tools@15.32.1 emulators:exec --only firestore --project demo-vaulte \"npm run -s test:api:run\"",
    "test:api:run": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/api/github-reporter.mjs --test-reporter-destination=stdout tests/api/*.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "heic2any": "^0.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "vite": "^5.0.0"
  }
}
